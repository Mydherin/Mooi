# Postgres engine
POSTGRES_DB=mooi
POSTGRES_USER=mooi
POSTGRES_PASSWORD=change-me
POSTGRES_SCHEMA=public
POSTGRES_HOST=localhost
# Dev ports are pinned by make/ports.mk and exported over these values for `make dev-*`.
POSTGRES_PORT=54983

# pgAdmin console
PGADMIN_EMAIL=admin@mooi.dev
PGADMIN_PASSWORD=change-me
PGADMIN_PORT=51247

# Dev entrypoint
DEV_HEALTH_TIMEOUT=180
DEV_STOP_TIMEOUT=15
DEV_SERVICE_TIMEOUT=120
DEV_POLL_INTERVAL=1
DEV_LOG_LINES=50
