# Postgres engine
POSTGRES_DB=mooi
POSTGRES_USER=mooi
POSTGRES_PASSWORD=change-me
POSTGRES_SCHEMA=public
POSTGRES_HOST=localhost
# `make dev-*` overrides it with the loopback port the engine assigns to the compose postgres.
POSTGRES_PORT=54983

# Dev entrypoint
DEV_HEALTH_TIMEOUT=180
DEV_STOP_TIMEOUT=15
DEV_SERVICE_TIMEOUT=120
DEV_POLL_INTERVAL=1
DEV_LOG_LINES=50
