# Application
APP_NAME=mic-mooi
APP_VERSION=0.1.0
# Dev ports are pinned by make/ports.mk and exported over these values for `make dev-*`.
SERVER_PORT=39615

# Database connection is inherited from the monorepo root .env file
# (POSTGRES_HOST, POSTGRES_PORT, POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_SCHEMA)

# Connection pool
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=30000

# Database migrations
DB_MIGRATIONS_ENABLED=true

# Web
CORS_ORIGIN=http://localhost:28471

# Auth
# Google OAuth2 client id of the SPA, also the expected `aud` of every Google ID token
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# HS256 signing key for access tokens, at least 32 bytes
JWT_SECRET=change-me-development-secret-at-least-32-bytes
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
REPLAY_GRACE_SECONDS=30
# Comma separated addresses granted the admin role at signup only
ADMIN_EMAILS=

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_AUTH=INFO
