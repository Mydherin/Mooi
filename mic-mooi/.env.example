# Application
APP_NAME=mic-mooi
APP_VERSION=0.1.0
SERVER_PORT=8080

# Database (Postgres instance must already exist)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mooi
DB_USER=mooi
DB_PASSWORD=mooi
DB_SCHEMA=public
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=30000

# Database migrations
DB_MIGRATIONS_ENABLED=true

# Web
WEB_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
