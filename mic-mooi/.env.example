# Application
APP_NAME=mic-mooi
APP_VERSION=0.1.0
SERVER_PORT=8080

# Database connection is inherited from the monorepo root .env file
# (POSTGRES_HOST, POSTGRES_PORT, POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_SCHEMA)

# Connection pool
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=30000

# Database migrations
DB_MIGRATIONS_ENABLED=true

# Web
WEB_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
