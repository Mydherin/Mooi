# Application
APP_NAME=mic-mooi
APP_VERSION=0.1.0
# Reference settings; container ports and API URLs are supplied by Compose.
SERVER_PORT=39615

# Database connection is inherited from the monorepo root .env file
# (POSTGRES_HOST, POSTGRES_PORT, POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_SCHEMA)

# Connection pool
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=30000

# Database migrations
DB_MIGRATIONS_ENABLED=true

# Web
CORS_ORIGIN=http://localhost:28471

# Crypto
# AES-256-GCM key encrypting third-party tokens at rest; generate with `openssl rand -base64 32`
SECRETS_KEY=generate-me-with-openssl-rand-base64-32

# Service to service
# Shared secret required by endpoints that hand internal services a third-party credential
SERVICE_TOKEN=change-me-service-token-at-least-32-bytes

# Auth
# Google OAuth2 client id of the SPA, also the expected `aud` of every Google ID token
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# HS256 signing key for access tokens, at least 32 bytes
JWT_SECRET=change-me-development-secret-at-least-32-bytes
ACCESS_TOKEN_EXPIRES_IN=15m
# Sliding inactivity window: every renewal re-issues it, 30 days without use signs the player out
REFRESH_TOKEN_EXPIRES_IN=30d
# Optional absolute ceiling measured from the session's creation; blank = no ceiling
SESSION_MAX_LIFETIME=
# Nightly deletion of expired refresh tokens; spent but unexpired rows are kept on purpose
REFRESH_TOKEN_PURGE_CRON=0 30 3 * * *
REPLAY_GRACE_SECONDS=30
# HttpOnly cookie carrying the refresh token; the path is the public path of the auth endpoints behind the gateway
AUTH_REFRESH_COOKIE_NAME=mooi_refresh
AUTH_REFRESH_COOKIE_PATH=/api/mooi/auth
# `false` only for plain-http hosts other than localhost
AUTH_REFRESH_COOKIE_SECURE=true
# Transition only: also accept/return the refresh token in JSON bodies (pre-cookie clients)
AUTH_LEGACY_BODY_TOKEN_ENABLED=true
# Comma separated addresses granted the admin role at signup only
ADMIN_EMAILS=
# Development only: `true` skips Google and signs every login in as AUTH_GOOGLE_MOCK_EMAIL (SPA: VITE_AUTH_GOOGLE_MOCK)
AUTH_GOOGLE_MOCK_ENABLED=false
AUTH_GOOGLE_MOCK_EMAIL=developer@mooi.dev
# Development only, with the mock: accounts linked to the mocked player at boot (optional). Independent,
# non-rotating credentials: GitHub personal access token, `claude setup-token` token, Codex auth.json
AUTH_GOOGLE_MOCK_GITHUB_TOKEN=
AUTH_GOOGLE_MOCK_CLAUDE_TOKEN=
AUTH_GOOGLE_MOCK_CODEX_AUTH_JSON=

# GitHub
# GitHub App with "Expire user authorization tokens" enabled, the only setup issuing refresh tokens.
# It must be public ("Any account" can install it, Advanced > Make public): GitHub answers 404 on the
# authorize and install pages to every account but the owner of a private app.
GITHUB_CLIENT_ID=Iv23liYourGithubAppClientId
GITHUB_CLIENT_SECRET=your-github-app-client-secret
# App URL slug (from https://github.com/apps/<slug>); sends players to the install-and-authorize
# page, the only way a player grants Mooi repositories. Without it only the app owner, who can install
# it from GitHub settings, reaches any repository.
GITHUB_APP_SLUG=your-github-app-slug
# Compose supplies the callback URL for the deployed origin.
GITHUB_REDIRECT_URI=http://localhost:28471/account/github/callback
GITHUB_AUTHORIZE_URI=https://github.com/login/oauth/authorize
GITHUB_TOKEN_URI=https://github.com/login/oauth/access_token
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_STATE_EXPIRES_IN=10m
GITHUB_TOKEN_REFRESH_SKEW=5m
GITHUB_REQUEST_TIMEOUT_MS=10000

# Agent providers
AGENT_STATE_EXPIRES_IN=10m
# Claude sign-in tokens live 8h; renewing 1h early lets a turn started on one finish on it.
AGENT_TOKEN_REFRESH_SKEW=1h
AGENT_REQUEST_TIMEOUT_MS=10000
# Claude is linked by the Claude Code sign-in (OAuth2 + PKCE with Claude Code's own public client, the
# code pasted back from Anthropic's page): nothing to register. false offers `claude setup-token` instead.
AGENT_CLAUDE_ENABLED=true

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_AUTH=INFO
LOG_LEVEL_GITHUB=INFO
LOG_LEVEL_AGENTS=INFO
