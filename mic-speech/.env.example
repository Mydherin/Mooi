# Application
APP_NAME=mic-speech
APP_VERSION=0.1.0
# Loopback only. Dev port is pinned by make/ports.mk and exported over this value for `make dev-*`.
SPEECH_HOST=127.0.0.1
SPEECH_PORT=59100

# Web: SPA origin, the only WebSocket Origin accepted
CORS_ORIGIN=http://localhost:28471

# Recognition: forced language (never auto-detected nor translated)
SPEECH_LANGUAGE=es-ES
# Comma-separated domain phrases to bias (boost 3.0); ignored by GGUFs without an embedded tokenizer
SPEECH_CONTEXTS=
# Maximum recording length in seconds (1-1800)
SPEECH_MAX_SECONDS=300

# Native engine (NVIDIA NeMo-Speech.cpp 0.1.0). Empty runtime path: provisioned into
# SPEECH_RUNTIME_DIR by `make dev-start`, then `nemo-speech` on PATH.
SPEECH_RUNTIME_PATH=
SPEECH_RUNTIME_DIR=.runtime
# Indexed model (pinned revision + checksum) or a local GGUF path
SPEECH_MODEL=nemotron-3.5
# Empty: metal on Apple Silicon, auto elsewhere
SPEECH_DEVICE=
SPEECH_STARTUP_TIMEOUT_SECONDS=60

# Content-free metrics (counts and timings only)
SPEECH_METRICS_PATH=~/.cache/mooi/speech/metrics.sqlite
SPEECH_METRICS_RETENTION_DAYS=30

# Logging
LOG_LEVEL=INFO
