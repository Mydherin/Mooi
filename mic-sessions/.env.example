# Application
APP_NAME=mic-sessions
APP_VERSION=0.1.0
# Dev ports are pinned by make/ports.mk and exported over these values for `make dev-*`.
SESSIONS_PORT=44913

# Upstream API
MOOI_API_BASE_URL=http://localhost:39615
# Same value as mic-mooi SERVICE_TOKEN
SERVICE_TOKEN=change-me-service-token-at-least-32-bytes
# Same value as mic-mooi JWT_SECRET, used to verify access tokens locally
JWT_SECRET=change-me-development-secret-at-least-32-bytes
INTROSPECTION_CACHE_SECONDS=30

# Web
CORS_ORIGIN=http://localhost:28471

# Workspaces
WORKSPACE_ROOT=.workspaces
GIT_BINARY=git
GIT_TIMEOUT_SECONDS=180

# Sessions
MAX_SESSIONS=8
MAX_SESSIONS_PER_PLAYER=4
SESSION_IDLE_TIMEOUT_MINUTES=180
# Coalesce authenticated preview heartbeats; automatic events never renew idle activity.
SESSION_ACTIVITY_INTERVAL_SECONDS=60
EVENT_LOG_LIMIT=5000
EVENT_LOG_BYTES=8388608
SSE_HEARTBEAT_SECONDS=15
# Trailing window coalescing mid-turn changes recomputes
CHANGES_DEBOUNCE_SECONDS=1.5

# Session deployments — requires Docker CLI with Compose v2 and access to the host socket.
# In a container/pod, mount the host socket here; checkout paths need not match host paths.
DOCKER_BINARY=docker
# Optional absolute plugin directory when Compose/buildx are not installed system-wide.
# Docker Desktop macOS: /Applications/Docker.app/Contents/Resources/cli-plugins
DOCKER_CLI_PLUGIN_DIR=
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_COMMAND_TIMEOUT_SECONDS=30
DOCKER_BUILD_TIMEOUT_SECONDS=1200
DOCKER_OUTPUT_LIMIT_BYTES=65536
DEPLOYMENT_TIMEOUT_SECONDS=1800
DEPLOYMENT_READINESS_TIMEOUT_SECONDS=90
# Whole budget for a stop. Containers get half of it as SIGTERM grace before SIGKILL.
DEPLOYMENT_STOP_TIMEOUT_SECONDS=60
DEPLOYMENT_PROBE_TIMEOUT_SECONDS=5
DEPLOYMENT_MONITOR_INTERVAL_SECONDS=15
# Maximum bind attempts, including the initial attempt (1–3).
DEPLOYMENT_PORT_ATTEMPTS=3
# Build+start attempts per deployment operation; a failure returns its log to the agent (1–3).
DEPLOYMENT_START_ATTEMPTS=2
# Maximum deployment.activity events per operation; one truncation notice closes the log.
DEPLOYMENT_ACTIVITY_LIMIT=400
# Total UTF-8 budget per operation. The final outcome is always emitted outside this budget.
DEPLOYMENT_ACTIVITY_BYTES=524288
# Activity detail is truncated to this size before redaction.
DEPLOYMENT_ACTIVITY_TEXT_BYTES=12288
# Redacted Compose output tail returned to the agent and published as activity.
DEPLOYMENT_LOG_TAIL_LINES=40
MAX_DEPLOYMENTS=4

# Local development defaults. For server deployment, set PUBLIC_HOST to the server's
# browser-accessible DNS/IP and BIND_ADDRESS to a host interface IP (e.g. 0.0.0.0).
# PROBE_HOST is the daemon host address reachable FROM mic-sessions, not the app container.
# Hosts contain no scheme/port/path; IPv6 addresses have no brackets.
PREVIEW_PUBLIC_HOST=127.0.0.1
PREVIEW_SCHEME=http
PREVIEW_BIND_ADDRESS=127.0.0.1
PREVIEW_PROBE_HOST=127.0.0.1
# Empty: Docker assigns free host ports. Optional inclusive range, e.g. 49152-49251.
PREVIEW_PORT_RANGE=
# HTTPS requires real TLS on the app endpoint; changing SCHEME does not enable TLS.
# Existing infrastructure owns ingress/firewall/TLS. Ports are accessible outside Mooi.
# Deployment model/effort are fixed internally, independent of the chat settings below.

# Agent runtime — knobs are namespaced per provider (AGENT_<PROVIDER>_*); these are Claude Code
# concepts and only ClaudeAgentRuntime reads them. A second provider adds its own block.
AGENT_CLAUDE_MODEL=sonnet
AGENT_CLAUDE_EFFORT=high
# Optional JSON chat catalog; only these model/effort combinations are offered.
# AGENT_CLAUDE_MODELS={"sonnet":["low","medium","high"],"opus":["low","medium","high","max"],"haiku":[]}
AGENT_CLAUDE_DISALLOWED_TOOLS=

# Logging
LOG_LEVEL=INFO
