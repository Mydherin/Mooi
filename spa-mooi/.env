# Dev server
# Dev ports are pinned by make/ports.mk and exported over these values for `make dev-*`.
VITE_DEV_HOST=localhost
VITE_DEV_PORT=28471
VITE_PREVIEW_PORT=4173

# Application identity
VITE_APP_NAME=Mooi
VITE_APP_TAGLINE=ship from a chat
VITE_APP_DESCRIPTION=Mooi turns your GitHub repositories into agent sessions: chat, watch the code change, preview the running app and deploy to production without leaving the workspace.
VITE_APP_VERSION=0.1.0

# Links
VITE_GITHUB_URL=https://github.com
VITE_DOCS_URL=https://vite.dev
VITE_CONTACT_EMAIL=hello@mooi.dev

# API
VITE_API_BASE_URL=http://localhost:39615

# Google OAuth2
VITE_GOOGLE_CLIENT_ID=225689598324-74e7jfd9nucf8bs3gr71l9af6u460vhv.apps.googleusercontent.com

# Client storage
VITE_STORAGE_PREFIX=mooi
